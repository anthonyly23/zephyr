mainmenu "Vendor-class bulk sample"

config APP_VENDOR_BULK_PRODUCER
	bool "Run a producer thread that fills the bulk IN endpoint"
	default y
	help
	  When enabled, a Zephyr thread continuously generates a counter
	  pattern and submits it on the bulk IN endpoint. When disabled, the
	  custom class auto-re-enqueues echo from OUT into IN (loopback).

config APP_VENDOR_BULK_XFER_SIZE
	int "Per-transfer size (bytes)"
	default 16384
	range 64 131072
	help
	  Size of each bulk IN/OUT transfer. Must be a multiple of 64 (FS) or
	  512 (HS) for best throughput. Bound by CONFIG_UDC_BUF_POOL_SIZE.

config APP_VENDOR_BULK_IN_DEPTH
	int "Number of bulk IN transfers kept in flight"
	default 4
	range 1 16
	help
	  Pipeline depth for the bulk IN endpoint. Higher values keep the USB
	  controller busy across software latency between transfers, at the
	  cost of XFER_SIZE * IN_DEPTH bytes of RAM. UDC pool must be sized to
	  hold all outstanding buffers (UDC_BUF_COUNT >= IN_DEPTH + 2).

source "samples/subsys/usb/common/Kconfig.sample_usbd"

source "Kconfig.zephyr"
